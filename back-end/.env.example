PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:your_password@db.yourproject.supabase.co:5432/postgres
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRE=30d
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
DEFAULT_ADMIN_PASSWORD=your_admin_password_here

# Email Verification (SMTP) Configuration
# Option 1: Gmail (Generate 16-character App Password at https://myaccount.google.com/apppasswords)
# EMAIL_SERVICE=gmail
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_16_char_app_password

# Option 2: Mailtrap (Free testing at https://mailtrap.io)
# EMAIL_HOST=sandbox.smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USER=your_mailtrap_user
# EMAIL_PASS=your_mailtrap_pass
# EMAIL_FROM="Taurus Bike Shop" <no-reply@taurusbike.com>

